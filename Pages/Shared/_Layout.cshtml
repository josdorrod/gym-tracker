<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymTracker</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5/dist/brite/bootstrap.min.css" rel="stylesheet"> 
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymTracker.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="site-shell">
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light topbar">
            <div class="container app-container">
                <a class="navbar-brand d-flex align-items-center gap-3" asp-area="" asp-page="/Index">
                    <span class="brand-mark">GT</span>
                    <span>
                        <span class="brand-title">GymTracker</span>
                        <span class="brand-subtitle">Planifica. Registra. Mejora.</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between align-items-center">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Plans/Index">Planes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Exercises/Index">Ejercicios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Locations/Index">Ubicaciones</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="app-main">
        <div class="container app-container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container app-container d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <p class="mb-0">&copy; 2026 GymTracker. Una base simple para planificar y registrar entrenamientos.</p>
            <a asp-area="" asp-page="/Privacy" class="footer-link">Privacidad</a>
        </div>
    </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
