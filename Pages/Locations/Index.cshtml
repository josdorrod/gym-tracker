@page
@model GymTracker.Pages.Locations.IndexModel
@{
    ViewData["Title"] = "Ubicaciones";
}

<section class="d-flex flex-column gap-4">
    <div class="page-hero d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4 mb-0">
        <div>
            <p class="page-kicker">Gestión rápida</p>
            <h1 class="page-title">Ubicaciones</h1>
            <p class="page-subtitle">Crea, edita y elimina gimnasios sin salir del listado gracias a un flujo ligero con modales.</p>
        </div>
        <div class="hero-actions">
            <button type="button"
                    class="btn btn-primary"
                    data-modal-url="@Url.Page("Create")"
                    data-modal-title="Nueva ubicación"
                    data-modal-refresh-url="@Url.Page("List")"
                    data-modal-refresh-target="#locations-list-container">
                Nueva ubicación
            </button>
        </div>
    </div>

    <div id="locations-list-container">
        <partial name="_LocationTable" model="Model.Locations" />
    </div>
</section>

<div class="modal fade" id="crud-modal" tabindex="-1" aria-labelledby="crud-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="crud-modal-title">Gestionar ubicación</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" data-modal-body>
                <div class="location-modal-loading text-center py-4">
                    <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                    <p class="text-muted mt-3 mb-0">Cargando formulario…</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}