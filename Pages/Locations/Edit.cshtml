@page "{id:int}"
@model GymTracker.Pages.Locations.EditModel
@{
    Layout = null;
}

<form method="post" asp-page="/Locations/Edit" asp-route-id="@RouteData.Values["id"]" data-modal-form novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

    <partial name="_LocationFormFields" model="Model.Input" />

    <div class="d-flex justify-content-end gap-2 pt-3 border-top mt-4">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
</form>