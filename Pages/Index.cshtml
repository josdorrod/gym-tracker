@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}



<div class="container py-5">
    <!-- Título -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">Gym Tracker</h1>
        <p class="text-muted">Gestiona tus entrenamientos fácilmente</p>
    </div>

    <!-- Cards -->
    <div class="row g-4 justify-content-center">

        <!-- Ejercicios -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center">
                <div class="card-body d-flex flex-column align-items-center">
                    <span class="mb-3 fs-2">🏋️</span>
                    <h5 class="card-title">Ejercicios</h5>
                    <p class="card-text">Consulta y gestiona tus ejercicios</p>
                    <a class="btn btn-primary mt-auto" asp-page="/Ejercicios/Index">Ver ejercicios</a>
                </div>
            </div>
        </div>

        <!-- Planes -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center">
                <div class="card-body d-flex flex-column align-items-center">
                    <span class="mb-3 fs-2">📋</span>
                    <h5 class="card-title">Planes</h5>
                    <p class="card-text">Organiza tus rutinas y metas</p>
                    <a class="btn btn-success mt-auto" asp-page="/Plans/Index">Ver planes</a>
                </div>
            </div>
        </div>

        <!-- Ubicaciones -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center">
                <div class="card-body d-flex flex-column align-items-center">
                    <span class="mb-3 fs-2">🧭</span>
                    <h5 class="card-title">Ubicaciones</h5>
                    <p class="card-text">Gestiona tus gimnasios y sedes</p>
                    <a class="btn btn-warning mt-auto" asp-page="/Locations/Index">Ver ubicaciones</a>
                </div>
            </div>
        </div>

    </div>
</div>