@page
@model GymTracker.Pages.Plans.IndexModel
@{
    ViewData["Title"] = "Planes de entranamiento";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Planes de entrenamiento</h1>
    <a asp-page="Create" class="btn btn-primary">Nuevo Plan</a>
</div>

@if (!Model.Plans.Any())
{
    <p class="text-muted">No hay planes registrados todavía.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var plan in Model.Plans)
            {
                <tr>
                    <td>@plan.Name</td>
                    <td class="text-break" style="white-space: pre-line;">@(plan.Description ?? "—")</td>
                    <td class="text-end">
                        <a asp-page="Detail" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-page="Edit" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
