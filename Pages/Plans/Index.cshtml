@page
@model GymTracker.Pages.Plans.IndexModel
@{
    ViewData["Title"] = "Planes de entrenamiento";
}

<section class="d-flex flex-column gap-4">
    <div class="page-hero d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
        <div>
            <p class="page-kicker">Planificacion</p>
            <h1 class="page-title">Planes de entrenamiento</h1>
            <p class="page-subtitle">Organiza rutinas completas, asigna ejercicios y mantén una estructura mucho mas clara para el seguimiento semanal.</p>
        </div>
        <div class="hero-actions">
            <a asp-page="Create" class="btn btn-primary">Nuevo plan</a>
        </div>
    </div>

    <div class="section-panel">
        <div class="panel-header">
            <div>
                <h2 class="panel-title">Listado de planes</h2>
                <p class="panel-subtitle">Accede al detalle de cada plan para gestionar ejercicios y revisar su estructura.</p>
            </div>
            <span class="metric-chip">@Model.Plans.Count() planes</span>
        </div>

        @if (!Model.Plans.Any())
        {
            <div class="empty-state">
                <h2>No hay planes registrados todavia</h2>
                <p>Crea un plan para empezar a agrupar ejercicios y dar contexto a tus sesiones de entrenamiento.</p>
            </div>
        }
        else
        {
            <div class="d-none d-md-block">
                <div class="table-shell">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Plan</th>
                                <th>Descripción</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plan in Model.Plans)
                            {
                                <tr>
                                    <td>
                                        <span class="record-title">@plan.Name</span>
                                    </td>
                                    <td class="text-break">@(string.IsNullOrWhiteSpace(plan.Description) ? "Sin descripción" : plan.Description)</td>
                                    <td class="text-end">
                                        <a asp-page="Detail" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-md-none mobile-list">
                @foreach (var plan in Model.Plans)
                {
                    <div class="mobile-list-item">
                        <div class="mobile-item-header">
                            <span class="record-title">@plan.Name</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(plan.Description))
                        {
                            <div class="mobile-item-body">
                                <p class="mb-0 text-soft">@plan.Description</p>
                            </div>
                        }
                        <div class="mobile-item-actions">
                            <a asp-page="Detail" asp-route-id="@plan.Id" class="btn btn-outline-primary">Ver detalle</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
