@model GymTracker.DTO.PlanCreateDTO
<div class="form-card">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

        <div class="row g-4">
            <div class="col-lg-6">
                <label asp-for="Name" class="form-label">Nombre</label>
                <input asp-for="Name" class="form-control" placeholder="Ej. Torso / Pierna" />
                <div class="field-hint">Usa un titulo corto y facil de reconocer en el listado.</div>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label">Descripción</label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Describe el objetivo del plan, la frecuencia o cualquier criterio de uso."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions mt-4">
            <button type="submit" class="btn btn-primary">Guardar plan</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>