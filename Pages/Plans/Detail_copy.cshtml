@page "{id:int}"
@model GymTracker.Pages.Plans.DetailModel

@{
    ViewData["Title"] = string.Concat(Model.PlanDto.Name, " - busqueda");
}

<section class="page-shell">
    <div class="page-hero">
        <p class="page-kicker">Vista auxiliar</p>
        <h1 class="page-title">Buscar ejercicios para @Model.PlanDto.Name</h1>
        <p class="page-subtitle">Esta pagina mantiene el mismo estilo visual y te permite explorar rapidamente la biblioteca para añadir movimientos al plan.</p>
    </div>

    <div class="section-panel">
        <form method="get" class="mb-4">
            <input type="hidden" name="id" value="@RouteData.Values["id"]" />
            <div class="row g-2">
                <div class="col-sm-8">
                    <input type="text" name="searchExercise" value="@Model.SearchExerciseQuery" placeholder="Buscar ejercicio..." class="form-control" />
                </div>
                <div class="col-sm-4 d-grid">
                    <button type="submit" class="btn btn-primary">Buscar</button>
                </div>
            </div>
        </form>

        @if (!Model.SearchResults.Any())
        {
            <div class="empty-state">
                <h2>No se encontraron ejercicios</h2>
                <p>Prueba otro termino o crea un nuevo ejercicio desde el listado principal.</p>
            </div>
        }
        else
        {
            <div class="table-shell table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Ejercicio</th>
                            <th class="text-end">Accion</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var exercise in Model.SearchResults)
                    {
                        <tr>
                            <td>
                                <span class="record-title">@exercise.Name</span>
                                <span class="record-subtitle">@(string.IsNullOrWhiteSpace(exercise.MuscleGroup) ? "Sin grupo muscular definido" : exercise.MuscleGroup)</span>
                            </td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="AddExercise">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="exerciseId" value="@exercise.Id" />
                                    <input type="hidden" name="searchExercise" value="@Model.SearchExerciseQuery" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Añadir</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>