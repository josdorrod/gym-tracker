@page
@model GymTracker.Pages.Exercises.IndexModel
@{
    ViewData["Title"] = "Ejercicios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ejercicios</h1>
    <a asp-page="Create" class="btn btn-primary">Nuevo Ejercicio</a>
</div>

@if (!Model.Exercises.Any())
{
    <p class="text-muted">No hay ejercicios registrados todavía.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Grupo Muscular</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var exercise in Model.Exercises)
            {
                <tr>
                    <td>@exercise.Name</td>
                    <td>@(exercise.MuscleGroup ?? "—")</td>
                    <td>
                        <a asp-page="Detail" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
