@page
@model GymTracker.Pages.Exercises.IndexModel
@{
    ViewData["Title"] = "Ejercicios";
}

<section class="page-shell">
    <div class="page-hero d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
        <div>
            <p class="page-kicker">Biblioteca de ejercicios</p>
            <h1 class="page-title">Ejercicios</h1>
            <p class="page-subtitle">Consulta, edita y amplia tu catalogo de ejercicios con una vista mas limpia y mas facil de escanear.</p>
        </div>
        <div class="hero-actions">
            <a asp-page="Create" class="btn btn-primary">Nuevo ejercicio</a>
        </div>
    </div>

    <div class="section-panel">
        <div class="panel-header">
            <div>
                <h2 class="panel-title">Listado</h2>
                <p class="panel-subtitle">Accede rapido al detalle de cada ejercicio y a sus acciones principales.</p>
            </div>
            <span class="metric-chip">@Model.Exercises.Count() ejercicios</span>
        </div>

        @if (!Model.Exercises.Any())
        {
            <div class="empty-state">
                <h2>Todavia no hay ejercicios registrados</h2>
                <p>Crea el primero para empezar a construir tus planes y registrar series sobre una base ordenada.</p>
            </div>
        }
        else
        {
            <div class="table-shell table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Ejercicio</th>
                            <th>Series planificadas</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exercise in Model.Exercises)
                        {
                            <tr>
                                <td>
                                    <span class="record-title">@exercise.Name</span>
                                    <span class="record-subtitle">@(string.IsNullOrWhiteSpace(exercise.MuscleGroup) ? "Sin grupo muscular definido" : exercise.MuscleGroup)</span>
                                </td>
                                <td>@exercise.PlannedSets</td>
                                <td class="text-end">
                                    <div class="d-inline-flex flex-wrap justify-content-end gap-2">
                                        <a asp-page="Detail" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                                        <a asp-page="Edit" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
